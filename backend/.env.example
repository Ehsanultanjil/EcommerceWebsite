# Copy to a shell env (do NOT commit a .env with real values — Spring Boot
# reads these from the process environment, not from a file).
#
# SUPABASE_DB_URL      JDBC URL to the Supabase Postgres instance — use the SESSION
#                      POOLER, not the direct db.<ref>.supabase.co host. Supabase's
#                      direct-connection host is IPv6-only; most local/dev networks
#                      and several PaaS hosts (Render/Railway included) are IPv4-only
#                      and will fail DNS resolution against it. The pooler is IPv4.
#                      Format: jdbc:postgresql://aws-0-<region>.pooler.supabase.com:5432/postgres
#                      (region + pooler host are shown in Settings -> Database -> Connection pooling)
# SUPABASE_DB_USERNAME Pooler username is "postgres.<project-ref>" (NOT plain "postgres" —
#                      that's only correct for the direct/non-pooler host).
# SUPABASE_DB_PASSWORD Database password (Settings -> Database in the Supabase dashboard).
# SUPABASE_URL         Project base URL (not secret — same value the frontend uses).
#                      Used to derive the JWKS endpoint for verifying Supabase Auth JWTs.
#                      Format: https://<project-ref>.supabase.co

SUPABASE_DB_URL=jdbc:postgresql://aws-0-<region>.pooler.supabase.com:5432/postgres
SUPABASE_DB_USERNAME=postgres.<project-ref>
SUPABASE_DB_PASSWORD=your-db-password-here
SUPABASE_URL=https://<project-ref>.supabase.co
